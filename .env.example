# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Security
APPROVAL_TOKEN_SECRET=your_secret_key_for_approval_tokens

# Database (Docker default, no need to change)
DATABASE_URL=postgresql+asyncpg://syrus:syrus_secret@postgres:5432/syrus

# Redis (Docker default, no need to change)
REDIS_URL=redis://redis:6379

# Mock API (Docker default, no need to change)
MOCK_API_URL=http://mock-api:8001

# App Settings
APP_NAME=Syrus Trading Copilot
DEBUG=False
